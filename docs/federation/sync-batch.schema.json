{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Fleet authorized task projection batch v1",
  "description": "Syntax only. Runtime additionally enforces source/owner binding, byte limits, sequential ordering, digests, versions and durable cursor rules.",
  "type": "object",
  "required": [
    "protocol_version",
    "origin_node_id",
    "origin_epoch",
    "project_id",
    "after_seq",
    "head_seq",
    "pending_count",
    "checkpoint",
    "events"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "origin_node_id": {
      "$ref": "#/$defs/uuid"
    },
    "origin_epoch": {
      "$ref": "#/$defs/uuid"
    },
    "project_id": {
      "$ref": "#/$defs/project"
    },
    "after_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "head_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pending_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "checkpoint": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "seq",
            "event_digest"
          ],
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "event_digest": {
              "$ref": "#/$defs/digest"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "events": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "task_uid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "project": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,79}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task": {
      "type": "object",
      "required": [
        "task_uid",
        "owner_node_id",
        "aggregate_version",
        "subject",
        "description",
        "acceptance",
        "status",
        "waiting_for",
        "kind",
        "parent_uid",
        "line",
        "run_id",
        "attempts",
        "max_attempts",
        "released",
        "result",
        "verdict_note",
        "archived_at",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "task_uid": {
          "$ref": "#/$defs/task_uid"
        },
        "owner_node_id": {
          "$ref": "#/$defs/uuid"
        },
        "aggregate_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "subject": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "acceptance": {
          "type": "string"
        },
        "status": {
          "enum": [
            "not_started",
            "in_progress",
            "waiting",
            "done"
          ]
        },
        "waiting_for": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "task",
            "goal"
          ]
        },
        "parent_uid": {
          "anyOf": [
            {
              "$ref": "#/$defs/task_uid"
            },
            {
              "type": "null"
            }
          ]
        },
        "line": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "released": {
          "type": "boolean"
        },
        "result": {
          "type": [
            "string",
            "null"
          ]
        },
        "verdict_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "archived_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "schema_version",
        "event_id",
        "origin_node_id",
        "origin_epoch",
        "project_id",
        "seq",
        "aggregate_uid",
        "aggregate_version",
        "kind",
        "payload",
        "payload_digest",
        "event_digest"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "event_id": {
          "$ref": "#/$defs/uuid"
        },
        "origin_node_id": {
          "$ref": "#/$defs/uuid"
        },
        "origin_epoch": {
          "$ref": "#/$defs/uuid"
        },
        "project_id": {
          "$ref": "#/$defs/project"
        },
        "seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "aggregate_uid": {
          "$ref": "#/$defs/task_uid"
        },
        "aggregate_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kind": {
          "enum": [
            "task.snapshot",
            "task.withdrawn"
          ]
        },
        "payload": {
          "type": "object"
        },
        "payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "event_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "task.snapshot"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "required": [
                  "task"
                ],
                "properties": {
                  "task": {
                    "$ref": "#/$defs/task"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "else": {
            "properties": {
              "payload": {
                "type": "object",
                "required": [],
                "properties": {},
                "additionalProperties": false
              }
            }
          }
        }
      ]
    }
  }
}
