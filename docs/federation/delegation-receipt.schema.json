{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Fleet delegation receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delegation_id",
    "project_id",
    "source_node_id",
    "source_epoch",
    "target_node_id",
    "target_epoch",
    "offer_digest",
    "version",
    "state",
    "target_task_uid",
    "note",
    "dispatch_ready"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "delegation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,79}$"
    },
    "source_node_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "target_node_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "target_epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "offer_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "state": {
      "enum": [
        "received",
        "accepted_unconfirmed",
        "rejected"
      ]
    },
    "target_task_uid": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 512
    },
    "dispatch_ready": {
      "const": false
    }
  },
  "oneOf": [
    {
      "properties": {
        "state": {
          "const": "received"
        },
        "version": {
          "const": 1
        },
        "target_task_uid": {
          "type": "null"
        },
        "note": {
          "const": ""
        }
      }
    },
    {
      "properties": {
        "state": {
          "const": "accepted_unconfirmed"
        },
        "version": {
          "const": 2
        },
        "target_task_uid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    {
      "properties": {
        "state": {
          "const": "rejected"
        },
        "version": {
          "const": 2
        },
        "target_task_uid": {
          "type": "null"
        }
      }
    }
  ],
  "description": "Runtime additionally binds both node epochs, project, contract digest and target task ownership; no receipt in v1 authorizes dispatch."
}
