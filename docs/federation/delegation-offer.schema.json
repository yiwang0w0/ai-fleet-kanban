{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Fleet delegation offer v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delegation_id",
    "project_id",
    "source_node_id",
    "source_epoch",
    "target_node_id",
    "target_epoch",
    "source_task_uid",
    "source_task_version",
    "task"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "delegation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,79}$"
    },
    "source_node_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "target_node_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "target_epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_task_uid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_task_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "description",
        "acceptance",
        "work_kind",
        "capabilities"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "maxLength": 16384
        },
        "acceptance": {
          "type": "string",
          "maxLength": 16384
        },
        "work_kind": {
          "enum": [
            "implement",
            "review"
          ]
        },
        "capabilities": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,79}$"
          }
        }
      }
    }
  },
  "description": "Runtime additionally enforces owner/epoch binding, distinct nodes, nonblank subject, no NUL text and canonical UTF-8 length <= 122880 bytes."
}
